{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/site",
  "rewrites": [
    { "source": "/app", "destination": "/app/index.html" },
    { "source": "/app/(.*)", "destination": "/app/index.html" }
  ],
  "redirects": [
    { "source": "/login", "destination": "/app/login", "permanent": true },
    { "source": "/alunos", "destination": "/app/alunos", "permanent": true },
    { "source": "/alunos/(.*)", "destination": "/app/alunos/$1", "permanent": true },
    { "source": "/agenda", "destination": "/app/agenda", "permanent": true }
  ]
}
